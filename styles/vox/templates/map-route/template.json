{
  "name": "map-route",
  "version": "1.0.0",
  "kind": "scene",
  "description": "A map with yellow land on a blue sea (or a paper palette), red pins with black name tags and an optional dashed red route drawn from place to place, slowly zooming in. Country shapes come from the bundled Natural Earth data; places come from engine.geo.search.",
  "useWhen": [
    "a place, city or country is mentioned",
    "a journey, trade route or migration",
    "where something happened"
  ],
  "durationMs": { "min": 1800, "default": 3500, "max": 5000 },
  "variables": {
    "type": "object",
    "properties": {
      "places": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 20 },
            "lat": { "type": "number", "minimum": -80, "maximum": 84 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "required": ["name", "lat", "lon"],
          "additionalProperties": false
        }
      },
      "route": { "type": "boolean" },
      "zoom": { "enum": ["world", "region", "city"] },
      "palette": { "enum": ["vox", "paper"] },
      "bg": { "enum": ["paper", "dark", "highlight"] }
    },
    "required": ["places"],
    "additionalProperties": false
  },
  "slots": { "places": "geo" },
  "sfxCues": [{ "name": "map-in", "atMs": "entrance", "sfx": "paper-pop", "type": "appear" }]
}
