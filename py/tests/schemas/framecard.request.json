{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vox_py/framecard.request",
  "title": "vox_py.framecard request",
  "type": "object",
  "additionalProperties": false,
  "required": ["images"],
  "properties": {
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1 }
    },
    "textLevel": { "enum": ["fast", "accurate"] }
  }
}
