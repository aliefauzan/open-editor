{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vox_py/palette.result",
  "title": "vox_py.palette result",
  "type": "object",
  "additionalProperties": false,
  "required": ["colors", "frames", "k"],
  "properties": {
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hex", "rgb", "share", "lightness", "saturation"],
        "properties": {
          "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
          "rgb": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "lightness": { "type": "number", "minimum": 0, "maximum": 1 },
          "saturation": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "frames": { "type": "integer", "minimum": 1 },
    "k": { "type": "integer", "minimum": 2, "maximum": 16 }
  }
}
