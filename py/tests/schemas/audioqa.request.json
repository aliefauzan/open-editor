{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vox_py/audioqa.request",
  "title": "vox_py.audioqa request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mix", "stems", "cues", "fps", "target", "outDir"],
      "properties": {
        "mode": { "const": "mix" },
        "outDir": { "type": "string", "minLength": 1 },
        "ffmpeg": { "type": "string", "minLength": 1 },
        "formatWhitelist": { "type": "string", "minLength": 1 },
        "mix": { "type": "string", "minLength": 1 },
        "stems": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sfx"],
          "properties": {
            "sfx": { "type": "string", "minLength": 1 },
            "speech": { "type": "string", "minLength": 1 }
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atMs", "type", "hero"],
            "properties": {
              "atMs": { "type": "integer", "minimum": 0 },
              "type": { "enum": ["cut", "move", "land", "appear", "hero"] },
              "hero": { "type": "boolean" }
            }
          }
        },
        "fps": { "type": "number", "exclusiveMinimum": 23, "exclusiveMaximum": 61 },
        "target": { "type": "number", "exclusiveMinimum": -71, "exclusiveMaximum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "styleId", "files", "outDir"],
      "properties": {
        "mode": { "const": "kit" },
        "outDir": { "type": "string", "minLength": 1 },
        "ffmpeg": { "type": "string", "minLength": 1 },
        "formatWhitelist": { "type": "string", "minLength": 1 },
        "styleId": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "type": { "enum": ["cut", "move", "land", "appear", "hero"] }
            }
          }
        }
      }
    }
  ]
}
