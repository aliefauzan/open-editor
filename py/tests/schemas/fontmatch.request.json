{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vox_py/fontmatch.request",
  "title": "vox_py.fontmatch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["videoPath", "samples", "fonts"],
  "properties": {
    "videoPath": {
      "type": "string",
      "minLength": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atMs", "lines"],
        "properties": {
          "atMs": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "box"],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "box": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "fonts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "\\.(ttf|otf|TTF|OTF)$"
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      }
    },
    "occlusion": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atMs", "boxes"],
        "properties": {
          "atMs": {
            "type": "integer",
            "minimum": 0
          },
          "boxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "w", "h"],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "w": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "h": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "ffmpeg": {
      "type": "string",
      "minLength": 1
    },
    "ffprobe": {
      "type": "string",
      "minLength": 1
    },
    "formatWhitelist": {
      "type": "string",
      "minLength": 1
    },
    "shortSide": {
      "type": "integer",
      "minimum": 160,
      "maximum": 1080
    },
    "normHeight": {
      "type": "integer",
      "minimum": 16,
      "maximum": 128
    }
  }
}
