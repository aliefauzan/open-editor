{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vox_py/timeline.request",
  "title": "vox_py.timeline request",
  "$defs": {
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "name", "rate", "tracks"],
      "properties": {
        "mode": { "const": "write" },
        "format": { "enum": ["otio", "fcpxml"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "output": { "type": "string", "pattern": "\\.(otio|fcpxml)$" },
        "name": { "type": "string" },
        "rate": { "$ref": "#/$defs/rate" },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "clips"],
            "properties": {
              "kind": { "enum": ["video", "audio"] },
              "name": { "type": "string" },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "path", "startFrame", "durationFrames", "sourceFrame"],
                  "properties": {
                    "name": { "type": "string" },
                    "path": { "type": "string", "pattern": "^/" },
                    "startFrame": { "type": "integer", "minimum": 0 },
                    "durationFrames": { "type": "integer", "minimum": 1 },
                    "sourceFrame": { "type": "integer", "minimum": 0 },
                    "sourceDurationFrames": { "type": "integer", "minimum": 1 },
                    "mediaDurationFrames": { "type": "integer", "minimum": 1 },
                    "mediaRate": { "$ref": "#/$defs/rate" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "path"],
      "properties": {
        "mode": { "const": "check" },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
