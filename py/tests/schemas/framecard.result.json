{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vox_py/framecard.result",
  "title": "vox_py.framecard result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "textLevel", "cards"],
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "scoredBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h", "score"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height", "labels", "text", "faces", "saliency", "ms"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "labels": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "confidence"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "confidence": { "type": "number", "exclusiveMinimum": 0.3, "maximum": 1 }
            }
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "box", "confidence"],
            "properties": {
              "text": { "type": "string" },
              "box": { "$ref": "#/$defs/box" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "faces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "boxes"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "boxes": { "type": "array", "items": { "$ref": "#/$defs/scoredBox" } }
          }
        },
        "saliency": { "oneOf": [{ "$ref": "#/$defs/scoredBox" }, { "type": "null" }] },
        "aesthetics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overall", "utility"],
          "properties": {
            "overall": { "type": "number", "minimum": -1, "maximum": 1 },
            "utility": { "type": "boolean" }
          }
        },
        "ms": { "type": "integer", "minimum": 0 }
      }
    },
    "failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "error"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "textLevel": { "enum": ["fast", "accurate"] },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "oneOf": [{ "$ref": "#/$defs/card" }, { "$ref": "#/$defs/failed" }] }
    }
  }
}
