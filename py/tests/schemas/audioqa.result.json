{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vox_py/audioqa.result",
  "title": "vox_py.audioqa result (the content of qa.json or kit-<styleId>.json, plus outDir)",
  "oneOf": [{ "$ref": "#/$defs/mix" }, { "$ref": "#/$defs/kit" }],
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "status": { "enum": ["pass", "fail", "skipped"] },
    "mix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "pass",
        "note",
        "fps",
        "targetLufs",
        "durationMs",
        "checks",
        "cues",
        "onsets",
        "listen",
        "png",
        "files",
        "thresholds",
        "outDir"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": { "const": "mix" },
        "pass": { "type": "boolean" },
        "note": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "targetLufs": { "type": "number" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            { "$ref": "#/$defs/cueTiming" },
            { "$ref": "#/$defs/oneEvent" },
            { "$ref": "#/$defs/spacing" },
            { "$ref": "#/$defs/underSpeech" },
            { "$ref": "#/$defs/loudness" }
          ]
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "atMs", "type", "hero"],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "atMs": { "type": "integer", "minimum": 0 },
              "type": { "enum": ["cut", "move", "land", "appear", "hero"] },
              "hero": { "type": "boolean" }
            }
          }
        },
        "onsets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ms", "peakDbfs", "cue"],
            "properties": {
              "ms": { "type": "integer", "minimum": 0 },
              "peakDbfs": { "type": "number" },
              "cue": { "type": ["integer", "null"] }
            }
          }
        },
        "listen": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atMs", "timecode", "kind", "listenFor"],
            "properties": {
              "atMs": { "type": "integer", "minimum": 0 },
              "timecode": { "type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9]\\.[0-9]{3}$" },
              "kind": { "enum": ["hero cue", "loud SFX", "speech overlap"] },
              "listenFor": { "type": "string", "minLength": 1 }
            }
          }
        },
        "png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "width",
            "height",
            "rows",
            "markerScanY",
            "markerWidthPx",
            "markers"
          ],
          "properties": {
            "file": { "const": "qa.png" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "y0", "y1"],
                "properties": {
                  "name": { "enum": ["sfx", "speech", "mix"] },
                  "y0": { "type": "integer" },
                  "y1": { "type": "integer" }
                }
              }
            },
            "markerScanY": { "type": "integer", "minimum": 0 },
            "markerWidthPx": { "type": "integer", "minimum": 1 },
            "markers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cue", "x", "hero"],
                "properties": {
                  "cue": { "type": "integer", "minimum": 1 },
                  "x": { "type": "integer", "minimum": 0 },
                  "hero": { "type": "boolean" }
                }
              }
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["qaJson", "png", "listen"],
          "properties": {
            "qaJson": { "const": "qa.json" },
            "png": { "const": "qa.png" },
            "listen": { "const": "LISTEN.md" }
          }
        },
        "thresholds": { "type": "object" },
        "outDir": { "type": "string", "minLength": 1 }
      }
    },
    "cueTiming": {
      "type": "object",
      "required": ["id", "rule", "status", "limitMs", "maxAbsDeltaMs", "cues", "failures"],
      "properties": {
        "id": { "const": "cueTiming" },
        "rule": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "limitMs": { "type": "number" },
        "maxAbsDeltaMs": { "$ref": "#/$defs/nullableNumber" },
        "cues": { "type": "array", "items": { "$ref": "#/$defs/timingRow" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/timingRow" } }
      }
    },
    "timingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue", "atMs", "onsetMs", "deltaMs", "deltaFrames"],
      "properties": {
        "cue": { "type": "integer", "minimum": 1 },
        "atMs": { "type": "integer", "minimum": 0 },
        "onsetMs": { "type": ["integer", "null"] },
        "deltaMs": { "type": ["integer", "null"] },
        "deltaFrames": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "oneEvent": {
      "type": "object",
      "required": ["id", "rule", "status", "onsets", "extraOnsets", "failures"],
      "properties": {
        "id": { "const": "oneEventPerCue" },
        "rule": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "onsets": { "type": "integer", "minimum": 0 },
        "extraOnsets": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["onsetMs", "afterCue"],
            "properties": {
              "onsetMs": { "type": "integer", "minimum": 0 },
              "afterCue": { "type": ["integer", "null"] }
            }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["id", "rule", "status", "minGapMs", "limitMs", "failures"],
      "properties": {
        "id": { "const": "spacing" },
        "rule": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "minGapMs": { "type": ["integer", "null"] },
        "limitMs": { "type": "integer" },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aMs", "bMs", "gapMs"],
            "properties": {
              "aMs": { "type": "integer" },
              "bMs": { "type": "integer" },
              "gapMs": { "type": "integer" }
            }
          }
        }
      }
    },
    "underSpeech": {
      "type": "object",
      "required": ["id", "rule", "status", "failures"],
      "properties": {
        "id": { "const": "sfxUnderSpeech" },
        "rule": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "reason": { "type": "string" },
        "limitLu": { "type": "number" },
        "windowMs": { "type": "integer" },
        "minMarginLu": { "$ref": "#/$defs/nullableNumber" },
        "onsets": { "type": "array", "items": { "$ref": "#/$defs/overlapRow" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/overlapRow" } }
      }
    },
    "overlapRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onsetMs", "speechActive", "marginLu"],
      "properties": {
        "onsetMs": { "type": "integer" },
        "speechActive": { "type": "boolean" },
        "marginLu": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "loudness": {
      "type": "object",
      "required": [
        "id",
        "rule",
        "status",
        "integratedLufs",
        "targetLufs",
        "deltaLu",
        "toleranceLu",
        "truePeakDbtp",
        "maxTruePeakDbtp",
        "clippedSamples",
        "parts",
        "failures"
      ],
      "properties": {
        "id": { "const": "loudness" },
        "rule": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "integratedLufs": { "$ref": "#/$defs/nullableNumber" },
        "targetLufs": { "type": "number" },
        "deltaLu": { "$ref": "#/$defs/nullableNumber" },
        "toleranceLu": { "type": "number" },
        "truePeakDbtp": { "type": "number" },
        "maxTruePeakDbtp": { "type": "number" },
        "clippedSamples": { "type": "integer", "minimum": 0 },
        "parts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrated", "truePeak", "clipping"],
          "properties": {
            "integrated": { "enum": ["pass", "fail"] },
            "truePeak": { "enum": ["pass", "fail"] },
            "clipping": { "enum": ["pass", "fail"] }
          }
        },
        "failures": { "type": "array", "items": { "enum": ["integrated", "truePeak", "clipping"] } }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "styleId",
        "pass",
        "note",
        "files",
        "sheet",
        "thresholds",
        "outDir"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": { "const": "kit" },
        "styleId": { "type": "string", "minLength": 1 },
        "pass": { "type": "boolean" },
        "note": { "type": "string" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "pass", "checks"],
            "properties": {
              "path": { "type": "string" },
              "type": { "enum": ["cut", "move", "land", "appear", "hero"] },
              "pass": { "type": "boolean" },
              "checks": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": ["id", "pass", "rule"],
                  "properties": {
                    "id": {
                      "enum": [
                        "notSynthesised",
                        "oneEvent",
                        "notNoiseBed",
                        "cleanEdges",
                        "peak",
                        "length"
                      ]
                    },
                    "pass": { "type": "boolean" },
                    "rule": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "sheet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "entries"],
          "properties": {
            "file": { "type": "string", "pattern": "^kit-.+\\.png$" },
            "entries": { "type": "integer", "minimum": 1 }
          }
        },
        "thresholds": { "type": "object" },
        "outDir": { "type": "string", "minLength": 1 }
      }
    }
  }
}
