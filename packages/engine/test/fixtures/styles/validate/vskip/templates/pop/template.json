{
  "name": "pop",
  "version": "1.0.0",
  "kind": "scene",
  "description": "Test scene: a card slides in, a dot pops at 500 ms, a label.",
  "useWhen": ["tests"],
  "durationMs": { "min": 500, "default": 3000, "max": 8000 },
