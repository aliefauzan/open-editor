{
  "name": "@vox/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "productName": "Vox Studio",
  "description": "Vox Studio desktop app (Electron)",
  "main": "out/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node scripts/build.ts && electron .",
    "test": "vitest run",
    "test:slow": "node scripts/build.ts && VOX_SLOW=1 vitest run",
    "e2e": "node scripts/build.ts && playwright test -c e2e/playwright.config.ts",
    "dist": "node scripts/build.ts --package && electron-builder --config electron-builder.yml --arm64 --mac dmg",
    "bench:timeline": "node bench/timeline.ts",
    "bench:latency": "node scripts/build.ts && node bench/latency.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hyperframes/player": "0.8.145",
    "@vox/engine": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vox/cli": "workspace:*",
    "@xzdarcy/react-timeline-editor": "1.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "zustand": "5.0.15"
  }
}
